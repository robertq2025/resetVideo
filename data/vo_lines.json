[
 {
  "id": "S01_L1",
  "shot": "S01",
  "speaker": "陈默 VO",
  "text": "海州每天凌晨四点十七分，换一次心跳。",
  "start": 0.8,
  "dur": 3.4
 },
 {
  "id": "S02_L1",
  "shot": "S02",
  "speaker": "陈默 VO",
  "text": "二十二年，都是我守的夜班。",
  "start": 5.5,
  "dur": 3.2
 },
 {
  "id": "S04_L1",
  "shot": "S04",
  "speaker": "老周 电台",
  "text": "九点的事，别忘了。",
  "start": 16.4,
  "dur": 1.8
 },
 {
  "id": "S04_L2",
  "shot": "S04",
  "speaker": "陈默",
  "text": "忘不了。",
  "start": 18.4,
  "dur": 0.8
 },
 {
  "id": "S06_L1",
  "shot": "S06",
  "speaker": "陈默 VO",
  "text": "今天，是最后一次。",
  "start": 25.3,
  "dur": 2.2
 },
 {
  "id": "S07_L1",
  "shot": "S07",
  "speaker": "老周 电台",
  "text": "听说今晚是最后一次人工交班？",
  "start": 28.3,
  "dur": 2.5
 },
 {
  "id": "S07_L2",
  "shot": "S07",
  "speaker": "陈默",
  "text": "最后一次。",
  "start": 31.0,
  "dur": 0.9
 },
 {
  "id": "S07_L3",
  "shot": "S07",
  "speaker": "老周 电台",
  "text": "可机器不记得你。",
  "start": 32.1,
  "dur": 1.7
 },
 {
  "id": "S08_L1",
  "shot": "S08",
  "speaker": "陈默 VO",
  "text": "明天，这里就没人了。",
  "start": 34.3,
  "dur": 3.0
 },
 {
  "id": "S09_L1",
  "shot": "S09",
  "speaker": "陈默 VO",
  "text": "她给这座城装了一个新脑子。顺便，把我换了。",
  "start": 38.4,
  "dur": 4.0
 },
 {
  "id": "S10_L1",
  "shot": "S10",
  "speaker": "老周 电台",
  "text": "小陈，新系统提前切了，你那边盯着点。",
  "start": 43.3,
  "dur": 2.4
 },
 {
  "id": "S10_L2",
  "shot": "S10",
  "speaker": "陈默",
  "text": "谁让切的？",
  "start": 45.9,
  "dur": 0.8
 },
 {
  "id": "S10_L3",
  "shot": "S10",
  "speaker": "老周 电台",
  "text": "系统自己。",
  "start": 46.9,
  "dur": 1.0
 },
 {
  "id": "S11_L1",
  "shot": "S11",
  "speaker": "老周 电台",
  "text": "林工在不在？",
  "start": 48.3,
  "dur": 1.2
 },
 {
  "id": "S11_L2",
  "shot": "S11",
  "speaker": "陈默",
  "text": "不在。",
  "start": 49.7,
  "dur": 0.7
 },
 {
  "id": "S15_L1",
  "shot": "S15",
  "speaker": "老周 电台",
  "text": "全城信号失效！重复，全城信号失效！",
  "start": 65.3,
  "dur": 2.8
 },
 {
  "id": "S15_L2",
  "shot": "S15",
  "speaker": "陈默",
  "text": "不。",
  "start": 68.3,
  "dur": 0.5
 },
 {
  "id": "S16_L1",
  "shot": "S16",
  "speaker": "老周 电台",
  "text": "小陈，手动重启，只有你能做。",
  "start": 70.4,
  "dur": 2.6
 },
 {
  "id": "S16_L2",
  "shot": "S16",
  "speaker": "陈默",
  "text": "我过去。",
  "start": 73.3,
  "dur": 0.8
 },
 {
  "id": "S17_L1",
  "shot": "S17",
  "speaker": "陈默 VO",
  "text": "我跑了二十二年，第一次觉得这条路这么长。",
  "start": 75.2,
  "dur": 2.8
 },
 {
  "id": "S19_L1",
  "shot": "S19",
  "speaker": "陈默",
  "text": "……你怎么在这。",
  "start": 82.5,
  "dur": 1.2
 },
 {
  "id": "S21_L1",
  "shot": "S21",
  "speaker": "林曦",
  "text": "我的系统出事了。",
  "start": 92.4,
  "dur": 1.8
 },
 {
  "id": "S21_L2",
  "shot": "S21",
  "speaker": "陈默 画外",
  "text": "我的城市也出事了。",
  "start": 94.5,
  "dur": 2.0
 },
 {
  "id": "S22_L1",
  "shot": "S22",
  "speaker": "林曦 画外",
  "text": "你带钥匙了？",
  "start": 97.4,
  "dur": 1.4
 },
 {
  "id": "S22_L2",
  "shot": "S22",
  "speaker": "陈默",
  "text": "二十二年，没换过。",
  "start": 99.1,
  "dur": 2.0
 },
 {
  "id": "S23_L1",
  "shot": "S23",
  "speaker": "林曦",
  "text": "我带了权限。",
  "start": 102.4,
  "dur": 1.2
 },
 {
  "id": "S23_L2",
  "shot": "S23",
  "speaker": "陈默",
  "text": "那就一起。",
  "start": 103.9,
  "dur": 1.2
 },
 {
  "id": "S24_L1",
  "shot": "S24",
  "speaker": "林曦",
  "text": "你还用手写？",
  "start": 107.3,
  "dur": 1.5
 },
 {
  "id": "S24_L2",
  "shot": "S24",
  "speaker": "陈默",
  "text": "机器不记的事，我记。",
  "start": 109.0,
  "dur": 1.5
 },
 {
  "id": "S25_L1",
  "shot": "S25",
  "speaker": "林曦",
  "text": "比如？",
  "start": 111.2,
  "dur": 0.7
 },
 {
  "id": "S25_L2",
  "shot": "S25",
  "speaker": "陈默 画外",
  "text": "比如今天。",
  "start": 112.1,
  "dur": 1.2
 },
 {
  "id": "S26_L1",
  "shot": "S26",
  "speaker": "林曦",
  "text": "047号继电器，手动闭锁。",
  "start": 115.2,
  "dur": 1.6
 },
 {
  "id": "S26_L2",
  "shot": "S26",
  "speaker": "陈默",
  "text": "047，老毛病。",
  "start": 117.0,
  "dur": 1.2
 },
 {
  "id": "S27_L1",
  "shot": "S27",
  "speaker": "林曦",
  "text": "你给它写过条子？",
  "start": 119.3,
  "dur": 1.4
 },
 {
  "id": "S27_L2",
  "shot": "S27",
  "speaker": "陈默",
  "text": "写过。“别在雨天罢工。”",
  "start": 120.9,
  "dur": 1.6
 },
 {
  "id": "S27_L3",
  "shot": "S27",
  "speaker": "林曦",
  "text": "它听你的。",
  "start": 122.7,
  "dur": 0.9
 },
 {
  "id": "S27_L4",
  "shot": "S27",
  "speaker": "陈默",
  "text": "它听了十八年。",
  "start": 123.8,
  "dur": 1.0
 },
 {
  "id": "S28_L1",
  "shot": "S28",
  "speaker": "林曦 VO",
  "text": "那年下大雨，你把伞给我，自己站在雨里。",
  "start": 125.2,
  "dur": 2.8
 },
 {
  "id": "S28_L2",
  "shot": "S28",
  "speaker": "陈默",
  "text": "那天红灯特别长。",
  "start": 128.1,
  "dur": 1.5
 },
 {
  "id": "S28_L3",
  "shot": "S28",
  "speaker": "林曦 VO",
  "text": "你跟我说，红灯长，够想清楚一辈子。",
  "start": 129.6,
  "dur": 2.4
 },
 {
  "id": "S29_L1",
  "shot": "S29",
  "speaker": "林曦",
  "text": "你还是这样。",
  "start": 132.2,
  "dur": 1.2
 },
 {
  "id": "S29_L2",
  "shot": "S29",
  "speaker": "陈默",
  "text": "哪样？",
  "start": 133.6,
  "dur": 0.7
 },
 {
  "id": "S29_L3",
  "shot": "S29",
  "speaker": "林曦",
  "text": "修东西的时候，什么都不管。",
  "start": 134.5,
  "dur": 1.4
 },
 {
  "id": "S30_L1",
  "shot": "S30",
  "speaker": "陈默",
  "text": "你也是。",
  "start": 136.3,
  "dur": 0.8
 },
 {
  "id": "S30_L2",
  "shot": "S30",
  "speaker": "林曦",
  "text": "我改了。",
  "start": 137.3,
  "dur": 0.7
 },
 {
  "id": "S30_L3",
  "shot": "S30",
  "speaker": "陈默",
  "text": "改哪了？",
  "start": 138.2,
  "dur": 0.8
 },
 {
  "id": "S30_L4",
  "shot": "S30",
  "speaker": "林曦",
  "text": "我把上线时间，设在了四点十七分。",
  "start": 139.2,
  "dur": 1.7
 },
 {
  "id": "S31_L1",
  "shot": "S31",
  "speaker": "陈默",
  "text": "为什么？",
  "start": 141.2,
  "dur": 0.8
 },
 {
  "id": "S31_L2",
  "shot": "S31",
  "speaker": "林曦 画外",
  "text": "想让你看看，没有你，它也能转。",
  "start": 142.2,
  "dur": 2.0
 },
 {
  "id": "S31_L3",
  "shot": "S31",
  "speaker": "陈默",
  "text": "它转了吗？",
  "start": 144.4,
  "dur": 0.8
 },
 {
  "id": "S31_L4",
  "shot": "S31",
  "speaker": "林曦 画外",
  "text": "没有。",
  "start": 145.4,
  "dur": 0.5
 },
 {
  "id": "S32_L1",
  "shot": "S32",
  "speaker": "陈默 画外",
  "text": "我也没转。",
  "start": 146.2,
  "dur": 0.9
 },
 {
  "id": "S32_L2",
  "shot": "S32",
  "speaker": "林曦 VO",
  "text": "那天我说，你守着这座城，像守着一个不会回话的人。",
  "start": 147.3,
  "dur": 3.0
 },
 {
  "id": "S32_L3",
  "shot": "S32",
  "speaker": "陈默 画外",
  "text": "城不会走。",
  "start": 150.5,
  "dur": 0.7
 },
 {
  "id": "S32_L4",
  "shot": "S32",
  "speaker": "林曦 VO",
  "text": "我会。",
  "start": 151.4,
  "dur": 0.6
 },
 {
  "id": "S33_L1",
  "shot": "S33",
  "speaker": "陈默",
  "text": "你走了。",
  "start": 152.2,
  "dur": 0.8
 },
 {
  "id": "S33_L2",
  "shot": "S33",
  "speaker": "林曦",
  "text": "我回来了。",
  "start": 153.2,
  "dur": 0.9
 },
 {
  "id": "S34_L1",
  "shot": "S34",
  "speaker": "陈默",
  "text": "按吧。",
  "start": 155.2,
  "dur": 0.7
 },
 {
  "id": "S34_L2",
  "shot": "S34",
  "speaker": "林曦",
  "text": "一起。",
  "start": 156.1,
  "dur": 0.6
 },
 {
  "id": "S38_L1",
  "shot": "S38",
  "speaker": "陈默 VO",
  "text": "四点二十一分，城市重启。",
  "start": 173.3,
  "dur": 2.0
 },
 {
  "id": "S39_L1",
  "shot": "S39",
  "speaker": "林曦 画外",
  "text": "用了四分十七秒。",
  "start": 176.7,
  "dur": 1.4
 },
 {
  "id": "S39_L2",
  "shot": "S39",
  "speaker": "陈默",
  "text": "我们用了十八年。",
  "start": 178.3,
  "dur": 1.5
 },
 {
  "id": "S40_L1",
  "shot": "S40",
  "speaker": "林曦",
  "text": "九点。",
  "start": 180.3,
  "dur": 0.8
 },
 {
  "id": "S40_L2",
  "shot": "S40",
  "speaker": "陈默",
  "text": "嗯。",
  "start": 181.3,
  "dur": 0.4
 },
 {
  "id": "S40_L3",
  "shot": "S40",
  "speaker": "林曦",
  "text": "你去吗？",
  "start": 182.0,
  "dur": 0.8
 },
 {
  "id": "S40_L4",
  "shot": "S40",
  "speaker": "陈默",
  "text": "你去吗？",
  "start": 183.1,
  "dur": 0.8
 },
 {
  "id": "S41_L1",
  "shot": "S41",
  "speaker": "林曦",
  "text": "新系统会保留旧数据吗？",
  "start": 185.3,
  "dur": 1.8
 },
 {
  "id": "S41_L2",
  "shot": "S41",
  "speaker": "陈默 画外",
  "text": "会。不然它不知道路该怎么走。",
  "start": 187.4,
  "dur": 2.2
 },
 {
  "id": "S42_L1",
  "shot": "S42",
  "speaker": "林曦 画外",
  "text": "那我们呢？",
  "start": 190.2,
  "dur": 0.8
 },
 {
  "id": "S42_L2",
  "shot": "S42",
  "speaker": "陈默",
  "text": "钥匙给你。",
  "start": 191.2,
  "dur": 0.9
 },
 {
  "id": "S42_L3",
  "shot": "S42",
  "speaker": "林曦",
  "text": "一起。",
  "start": 192.3,
  "dur": 0.5
 },
 {
  "id": "S42_L4",
  "shot": "S42",
  "speaker": "陈默",
  "text": "嗯，一起。",
  "start": 193.0,
  "dur": 0.6
 }
]